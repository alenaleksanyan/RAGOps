# =============================================================================
# RAG-Bench Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Application ---
APP_ENV=development
SECRET_KEY=change-me-to-a-strong-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- PostgreSQL ---
POSTGRES_USER=ragbench
POSTGRES_PASSWORD=ragbench_secret
POSTGRES_DB=ragbench
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ragbench:ragbench_secret@postgres:5432/ragbench

# --- Redis & ARQ ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- Server Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# LLM & Embedding Providers (add only the keys you want to use)
# Leave a key blank to disable that provider in the UI
# =============================================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Gemini / Vertex AI ---
GOOGLE_API_KEY=AIza...

# --- Groq (fast inference for Llama, Mixtral, Gemma) ---
GROQ_API_KEY=gsk_...

# --- Mistral AI ---
MISTRAL_API_KEY=...

# --- Cohere ---
COHERE_API_KEY=...

# --- Ollama (local models — no API key needed) ---
# Set to your Ollama server URL. Use http://host.docker.internal:11434 inside Docker.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_DEFAULT_EMBEDDING_MODEL=nomic-embed-text

# --- HuggingFace (for Sentence-Transformers / HF Inference API) ---
HUGGINGFACE_API_KEY=hf_...
# Local device for HuggingFace embeddings: "cpu" | "cuda" | "mps"
HUGGINGFACE_DEVICE=cpu

# =============================================================================
# Default Provider Config (Local First by Default)
# =============================================================================
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama3.2
DEFAULT_EMBEDDING_PROVIDER=fastembed
DEFAULT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Fixed Automated Evaluation & Judge LLM (Decoupled from SUT) ---
EVAL_LLM_PROVIDER=ollama
EVAL_LLM_MODEL=gemma4:e4b

# --- Reranker ---
# Options: "none" | "cross-encoder" | "cohere" | "bge"
DEFAULT_RERANKER=none

# =============================================================================
# Optional: MinIO / S3 for raw document binary storage
# =============================================================================
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=ragbench-docs
# MINIO_USE_SSL=false
